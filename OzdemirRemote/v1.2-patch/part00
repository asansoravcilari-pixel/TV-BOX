diff -ruN ozr_old/OzdemirRemote/core/src/main/java/com/ozdemir/remote/core/SecureKeyStore.kt ozr_compact/OzdemirRemote/core/src/main/java/com/ozdemir/remote/core/SecureKeyStore.kt
